{
    "name": "lordsimal/cakephp-psalm",
    "description": "A psalm-plugin for CakePHP",
    "type": "psalm-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Pfeifer",
            "email": "info@pfeiferkevin.at"
        }
    ],
    "require": {
        "php": ">=8.5",
        "vimeo/psalm": "^7.0",
        "cakephp/cakephp": "^6.0",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.13.5"
    },
    "extra": {
        "psalm": {
            "pluginClass": "LordSimal\\CakePHPPsalm\\Plugin"
        }
    },
    "autoload": {
        "psr-4": {
            "LordSimal\\CakePHPPsalm\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LordSimal\\CakePHPPsalm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@analyze",
            "@cs-check",
            "@test"
        ],
        "analyze": "psalm",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
