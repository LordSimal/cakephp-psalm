{
    "name": "lordsimal/cakephp-psalm",
    "description": "A psalm-plugin for CakePHP",
    "type": "psalm-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Pfeifer",
            "email": "info@pfeiferkevin.at"
        }
    ],
    "require": {
        "php": ">=8.5",
        "vimeo/psalm": "^7.0",
        "cakephp/cakephp": "^6.0",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "squizlabs/php_codesniffer": "^3.3",
        "psalm/plugin-phpunit": "^0.20.4",
        "weirdan/codeception-psalm-module": "^0.14",
        "codeception/codeception": "^5"
    },
    "extra": {
        "psalm": {
            "pluginClass": "LordSimal\\CakePHPPsalm\\Plugin"
        }
    },
    "autoload": {
        "psr-4": {
            "LordSimal\\CakePHPPsalm\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LordSimal\\CakePHPPsalm\\Tests\\": [
                "tests/_support",
                "tests"
            ]
        }
    },
    "scripts": {
        "check": [
            "@analyze",
            "@cs-check",
            "@unit-tests",
            "@acceptance-tests"
        ],
        "analyze": "codecept build && psalm",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "unit-tests": "phpunit --colors=always",
        "acceptance-tests": "codecept build && codecept --ansi run acceptance"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
